# Run-time environment of the Booking SaaS container. Copy to
# booking-saas.env ON THE SERVER only (chmod 600, owner root), never in git.
# The three NEXT_PUBLIC_* are also given at BUILD time (Dockerfile args).

NEXT_PUBLIC_APP_URL=https://booking-saas-staging.duckdns.org
NEXT_PUBLIC_SUPABASE_URL=https://osvlzlnwjnmjscpubawa.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable (or anon) key of the project>

# Secrets (values only on the server):
SUPABASE_SERVICE_ROLE_KEY=<service_role / secret key>
CRON_SECRET=<openssl rand -hex 32>
# The same value as Caddy's BOOKING_PROXY_SECRET (openssl rand -hex 32).
BOOKING_PROXY_SECRET=<openssl rand -hex 32>

# Ingress: Caddy (proxy mode, the default). Leave empty or "proxy".
BOOKING_TRUSTED_INGRESS=

# Emails: EMPTY = nothing is sent, the outbox keeps every email. Do not set
# "resend" before the SMTP/sending domain and the recipients are validated.
EMAIL_TRANSPORT=
EMAIL_FROM=
RESEND_API_KEY=

# Not configured for the beta (the integration answers calendar_not_configured).
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_CALENDAR_WEBHOOK_URL=
CALENDAR_TOKEN_ENCRYPTION_KEY=
CALENDAR_TOKEN_PREVIOUS_KEYS=

# Never set in production (the /apercu previews answer 404 without it).
# DASHBOARD_PREVIEW=
