# Public Supabase project settings. These values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-key

# Server-only secrets. Never prefix these variables with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=Studio Mila <reservations@example.test>
CRON_SECRET=replace-with-at-least-32-random-characters

# Canonical application URL used in public links, emails and auth redirects.
# Locally always http://localhost:3000 (never 127.0.0.1): it must match
# site_url and additional_redirect_urls in supabase/config.toml, otherwise the
# PKCE cookie set during sign-up is not found by /auth/callback.
# Production: the public origin, also configured as Site URL and redirect URL
# (<origin>/auth/callback) in the hosted Supabase dashboard.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Calendar (inbound busy sync). Leave empty to disable the integration
# (every calendar action then answers calendar_not_configured).
# OAuth client of type "Web application" in Google Cloud Console; its
# authorised redirect URI must be exactly GOOGLE_CALENDAR_REDIRECT_URI.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Defaults to <NEXT_PUBLIC_APP_URL>/api/calendar/google/callback.
GOOGLE_CALENDAR_REDIRECT_URI=
# Public HTTPS URL of /api/calendar/google/webhook for push notifications.
# Optional: without it, changes are picked up by the periodic job only.
GOOGLE_CALENDAR_WEBHOOK_URL=
# Encryption of OAuth tokens at rest (AES-256-GCM): 32 random bytes, base64
# (`openssl rand -base64 32`). Rotation: put the new key here and the former
# one(s) in CALENDAR_TOKEN_PREVIOUS_KEYS (comma-separated) until every token
# was rewritten (each refresh rewrites it; reconnecting rewrites all).
CALENDAR_TOKEN_ENCRYPTION_KEY=
CALENDAR_TOKEN_PREVIOUS_KEYS=
