# Public Supabase project settings. These values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-key

# Server-only secrets. Never prefix these variables with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=Studio Mila <reservations@example.test>
CRON_SECRET=replace-with-at-least-32-random-characters

# Canonical application URL used in public links, emails and auth redirects.
# Locally always http://localhost:3000 (never 127.0.0.1): it must match
# site_url and additional_redirect_urls in supabase/config.toml, otherwise the
# PKCE cookie set during sign-up is not found by /auth/callback.
# Production: the public origin, also configured as Site URL and redirect URL
# (<origin>/auth/callback) in the hosted Supabase dashboard.
NEXT_PUBLIC_APP_URL=http://localhost:3000
